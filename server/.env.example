# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://saripos_app:change_me@localhost:5433/saripos
JWT_ACCESS_SECRET=generate_with_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run seed` (dev data)
SEED_OWNER_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_OWNER_PIN=

# Used only by `npm test`: wiped and re-seeded on every run. Never point it at real data.
TEST_DATABASE_URL=postgres://saripos_app:change_me@localhost:5433/saripos_test

# Deployment only (see docs/DEPLOY.md). Leave unset locally.
# TRUST_PROXY=2          # proxies in front of the API: Vercel -> Render = 2
# DEMO_MODE=true         # public demo: user accounts can't be changed
